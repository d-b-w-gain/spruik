# Use documentation-only values here. Copy this file to .env and replace them.
PBX_LOCAL_NET=192.0.2.0/24
PBX_ADVERTISED_ADDRESS=192.0.2.10
TIMEZONE=Australia/Sydney
RING_SECONDS=35

SIP_TRUNK_HOST=sip.example.invalid
SIP_TRUNK_USERNAME=replace-me
SIP_TRUNK_PASSWORD=replace-me
SIP_TRUNK_MATCH_IP=198.51.100.10

EXTENSION_101_PASSWORD=replace-with-a-long-random-password
EXTENSION_102_PASSWORD=replace-with-another-long-random-password

KOKORO_URL=http://host.docker.internal:8880/v1/audio/speech
STANDARD_GREETING=Thanks for calling Example Engineering. Please hold while we connect your call.
STANDARD_VOICE=af_heart
HOLD_PROMO=While we connect your call, Example Engineering provides practical design and technical services. Thanks for holding. We will be with you shortly.
HOLD_VOICE=af_heart
VOICEMAIL_GREETING=Nobody is available to take your call. Please leave a message after the tone, then hang up when you are finished.
VOICEMAIL_VOICE=af_heart
THANK_YOU_MESSAGE=Thank you. Your message has been recorded.
THANK_YOU_VOICE=af_heart

# Optional signal-cli-rest-api delivery. Leave blank to retain recordings locally.
SIGNAL_API_URL=
SIGNAL_NUMBER=
SIGNAL_RECIPIENT=

# Optional management UI. Generate a long random token; leave empty to disable.
SPRUIK_ADMIN_TOKEN=
SPRUIK_MANAGER_HOST=127.0.0.1
SPRUIK_MANAGER_PORT=8088

# Digits only. These examples use reserved fictional number ranges.
VIP_NUMBER_LOCAL=0400000000
VIP_NUMBER_INTL=61400000000
VIP_GREETING=Good {daypart}, special caller. Welcome to Example Engineering. Please hold while we connect you.
VIP_VOICE=am_santa
