[general]
static=yes
writeprotect=yes
autofallthrough=yes

[globals]
RING_SECONDS=${RING_SECONDS}
TIMEZONE=${TIMEZONE}
SIGNAL_CALL_CONTROL_URL=${SIGNAL_CALL_CONTROL_URL}
SIGNAL_CALL_AUDIO_SERVICE=${SIGNAL_CALL_AUDIO_SERVICE}

[from-trunk]
exten => s,1,Goto(incoming,1)
exten => _X!,1,Goto(incoming,1)
exten => _+X!,1,Goto(incoming,1)

exten => incoming,1,NoOp(Incoming trunk call)
  same => n,Set(NORMALIZED_CALLER=${FILTER(0-9,${CALLERID(num)})})
  same => n,Set(DESKTOP_CONTACTS=${PJSIP_DIAL_CONTACTS(101)})
  same => n,Set(MOBILE_CONTACTS=${PJSIP_DIAL_CONTACTS(102)})
  same => n,GotoIf($[${LEN(${DESKTOP_CONTACTS})} = 0 & ${LEN(${MOBILE_CONTACTS})} = 0]?signal-route,s,1)
  same => n,GotoIf($["${NORMALIZED_CALLER}" = "${VIP_NUMBER_LOCAL}" | "${NORMALIZED_CALLER}" = "${VIP_NUMBER_INTL}"]?vip,1)
  same => n,Goto(standard,1)

exten => vip,1,NoOp(Personalized caller)
  same => n,Gosub(greeting,s,1(vip))
  same => n,Goto(ring-endpoints,s,1)

exten => standard,1,NoOp(Standard caller)
  same => n,Answer()
  same => n,Playback(custom/standard-greeting)
  same => n,Goto(ring-endpoints,s,1)

[ring-endpoints]
exten => s,1,Dial(PJSIP/101&PJSIP/102,${RING_SECONDS},tm(spruik-promo))
  same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?done)
  same => n,Goto(signal-route,s,1)
  same => n(done),Hangup()

[signal-route]
exten => s,1,NoOp(Calling Signal mobile endpoint)
  same => n,GotoIf($[${LEN(${SIGNAL_CALL_CONTROL_URL})} = 0 | ${LEN(${SIGNAL_CALL_AUDIO_SERVICE})} = 0]?voicemail,s,1)
  same => n,ExecIf($["${CHANNEL(state)}" = "Up"]?StartMusicOnHold(spruik-promo))
  same => n,Ringing()
  same => n,Set(CURLOPT(conntimeout)=5)
  same => n,Set(CURLOPT(httptimeout)=50)
  same => n,Set(SIGNAL_RESULT=${CURL(${SIGNAL_CALL_CONTROL_URL})})
  same => n,StopMusicOnHold()
  same => n,GotoIf($["${SIGNAL_RESULT}" != "connected"]?voicemail,s,1)
  same => n,Answer()
  same => n,Set(SIGNAL_AUDIO_UUID=${UUID()})
  same => n,AudioSocket(${SIGNAL_AUDIO_UUID},${SIGNAL_CALL_AUDIO_SERVICE})
  same => n,Hangup()

[voicemail]
exten => s,1,NoOp(Recording voicemail from ${CALLERID(all)})
  same => n,Answer()
  same => n,Wait(0.5)
  same => n,Set(VOICEMAIL_FILE=/var/spool/asterisk/voicemail/${STRFTIME(${EPOCH},${TIMEZONE},%Y%m%d-%H%M%S)}-${UNIQUEID}.wav)
  same => n,Playback(custom/voicemail-greeting)
  ; Generate the tone directly: minimal Asterisk images may not contain a beep file.
  same => n,PlayTones(1000/500)
  same => n,Wait(0.5)
  same => n,StopPlayTones()
  same => n,Record(${VOICEMAIL_FILE},5,120,kq)
  same => n,AGI(send-voicemail-signal.sh,${VOICEMAIL_FILE},${NORMALIZED_CALLER})
  same => n,Playback(custom/thank-you)
  same => n,Hangup()

exten => h,1,NoOp(Delivering retained voicemail after caller hangup)
  same => n,GotoIf($["${SIGNAL_SENT}" = "1"]?done)
  same => n,ExecIf($["${VOICEMAIL_FILE}" = ""]?Set(VOICEMAIL_FILE=/var/spool/asterisk/voicemail/${STRFTIME(${EPOCH},${TIMEZONE},%Y%m%d-%H%M%S)}-${UNIQUEID}.wav))
  same => n,AGI(send-voicemail-signal.sh,${VOICEMAIL_FILE},${NORMALIZED_CALLER})
  same => n(done),NoOp(Voicemail delivery complete)

[greeting]
exten => s,1,Ringing()
  same => n,Set(DAYPART=evening)
  same => n,Set(LOCAL_HOUR=${STRFTIME(${EPOCH},,%H)})
  same => n,ExecIf($[${LOCAL_HOUR} < 18]?Set(DAYPART=afternoon))
  same => n,ExecIf($[${LOCAL_HOUR} < 12]?Set(DAYPART=morning))
  same => n,AGI(generate-greeting.sh,${ARG1},${DAYPART},${UNIQUEID})
  same => n,Answer()
  same => n,Wait(0.5)
  same => n,ExecIf($["${TTS_FILE}" != ""]?Playback(${TTS_FILE}))
  same => n,Return()

[from-internal]
exten => 101,1,Dial(PJSIP/101,30)
  same => n,Hangup()
exten => 102,1,Dial(PJSIP/102,30)
  same => n,Hangup()
exten => 600,1,Answer()
  same => n,Playback(custom/standard-greeting)
  same => n,Hangup()
exten => 601,1,Answer()
  same => n,MusicOnHold(spruik-promo,35)
  same => n,Hangup()
exten => 602,1,Goto(voicemail,s,1)
exten => _X!,1,Dial(PJSIP/${EXTEN}@trunk-endpoint,60)
  same => n,Hangup()
exten => _+X!,1,Dial(PJSIP/${EXTEN}@trunk-endpoint,60)
  same => n,Hangup()
